# ── App ────────────────────────────────────────────────────────────────
# Public URL of the app. Use https://kidogopay.xyz in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Local: docker compose up -d  (see docker-compose.yml)
# Hosted: Neon, Supabase, Railway… any Postgres 14+ works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kidogopay

# ── Google sign-in (optional; the Google button hides when unset) ─────
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments (Qadi) ────────────────────────────────────────────────────
# mock = simulated rates, addresses and payouts (safe for local dev)
# live = real Qadi API calls (src/lib/payments/live.ts)
PAYMENTS_MODE=mock
QADI_API_BASE_URL=https://api.qadi.io
# sk_test_... for testing, sk_live_... in production (Qadi dashboard → Settings)
QADI_API_KEY=
# Qadi dashboard → webhook settings. Webhook URL: {APP_URL}/api/webhooks/qadi
QADI_WEBHOOK_SECRET=
# Optional KidogoPay fee, e.g. 1 = 1%. Charged via Qadi custom fees on KES (M-Pesa rail).
# Register a fee recipient per chain first: PUT /v1/custom-fee-recipients/{chain}
KIDOGO_FEE_PERCENT=
# Optional. The app polls Qadi for missed deposits every 5 minutes on its own.
# Set this only to call POST /api/cron/deposits from an external scheduler.
CRON_SECRET=

# ── Email (optional; emails print to the server console when unset) ───
RESEND_API_KEY=
EMAIL_FROM="KidogoPay <hello@kidogopay.xyz>"

# ── Limits ─────────────────────────────────────────────────────────────
# Lifetime USD volume allowed before business verification (KYB) is required.
KYB_THRESHOLD_USD=5000
